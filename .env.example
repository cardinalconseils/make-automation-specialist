# Make.com Automation Specialist — Environment Variables
# Copy this file to .env.local and fill in your values there.
# This file is COMMITTED — never put a real credential in it.

# ─────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────

# Make.com API key
# Get yours at: https://www.make.com/en/help/account/your-api-key
MAKE_API_KEY=

# Make.com Team ID
# Found in your Make.com team settings URL
MAKE_TEAM_ID=

# Make.com zone — the subdomain your account lives on (eu1, eu2, us1, us2)
# Check the host in your Make.com browser URL. Defaults to eu1 if left blank.
MAKE_ZONE=eu1

# ─────────────────────────────────────────────
# REQUIRED FOR TELEGRAM ALERTS
# ─────────────────────────────────────────────

# Telnyx API key
# Get yours at: https://portal.telnyx.com
TELNYX_API_KEY=

# Telegram chat ID to send alerts to
# Get this by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────
# OPTIONAL — Add as needed
# ─────────────────────────────────────────────

# Supabase (for persistent storage)
# SUPABASE_KEY must be the SERVICE ROLE key: every table has RLS enabled with no
# policies, so the anon key returns empty results rather than an error.
SUPABASE_URL=
SUPABASE_KEY=

# DataForSEO (Google Business Profile ratings and review topics)
# Dashboard → API Access at https://app.dataforseo.com/api-access
# NOTE: DataForSEO uses HTTP Basic auth, NOT an API key. The dashboard shows an
# "API login" and an "API password", and also a ready-made base64 token.
#   DATAFORSEO_LOGIN     the API login (an email address) — identification only
#   DATAFORSEO_AUTH_B64  base64("login:password") — this is the actual credential
# Send it as:  Authorization: Basic $DATAFORSEO_AUTH_B64
# Do NOT pass DATAFORSEO_AUTH_B64 as a password to `curl -u` — that returns 401.
DATAFORSEO_LOGIN=
DATAFORSEO_AUTH_B64=

# n8n (fallback automation platform)
N8N_BASE_URL=
N8N_API_KEY=

# GitHub (read project context)
GITHUB_TOKEN=
